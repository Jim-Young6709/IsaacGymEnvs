   "source": [
    "# generate debug state set\n",
    "python isaacgymenvs/presampling/pre_sample_scene_states_table_multi.py \\\n",
    "num_envs=128 task.env.scene.z_shift_range=\"[0.0,0.8]\" \\\n",
    "task.env.scene.mobile_obstacles.cuboids.num=1 \\\n",
    "presample.output_hdf5_name=debug_mobile1_0.0-0.8.hdf5\n",
    "\n",
    "# debug / gui / viser\n",
    "python isaacgymenvs/presampling/pre_sample_robot_init_pose.py \\\n",
    "task=DexMobileExpFull num_envs=9 seed=1 \\\n",
    "teacher.ckpt=./ckpts/exp_table_Feb23.pth \\\n",
    "task.env.scene.hdf5_path=./presampled_envs/scene_only/debug_mobile1_0.0-0.8.hdf5 \\\n",
    "presample.output_hdf5_name=debug_mobile1_0.0-0.8.hdf5 \\\n",
    "experiment=dagger_presample_debug \\\n",
    "task.env.enable_viser=True\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# merge hdf5 files\n",
    "python isaacgymenvs/utils/merge_presampled_hdf5.py \\\n",
    "--input_specs \\\n",
    "./presampled_envs/completed/table_multi_close_add_0.0-0.8* \\\n",
    "--output_path ./presampled_envs/completed/table_multi_close_0.0-0.8tableheight_1024*10.hdf5\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# debug dagger training with generated presampled hdf5\n",
    "torchrun --nnodes=1 --nproc_per_node=1 \\\n",
    "isaacgymenvs/distillation/run_dagger.py \\\n",
    "multi_gpu=True \\\n",
    "task=DexMobileExpFull num_envs=9 seed=1 \\\n",
    "teacher.ckpt=./ckpts/exp_table_Feb23.pth \\\n",
    "experiment=dagger_table_debug \\\n",
    "model=transformer_mobile_local_t_auxdelta \\\n",
    "dagger.learning_rate=1e-5 \\\n",
    "task.env.enable_viser=True \\\n",
